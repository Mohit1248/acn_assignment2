# build artifacts
/server
/client
*.o
*.obj

# generated at runtime - regenerate via scripts; final experiment CSVs/logs
# are committed explicitly as deliverables, not picked up implicitly
/metrics.csv
/health.log

# submission zips
*.zip

# python
__pycache__/
*.pyc

# experiment output: the CSVs, logs and configs under results/ are deliverables
# and ARE tracked; only the server-side copies of the workload are not
/results/**/*.data/
/results/**/_warmup/

# editor/OS cruft
.vscode/
.DS_Store
/tests/test_slice
